% apcalc.cls -- AP Calculus BC study series (guides, practice sets, practice exam)
% House math style: Latin Modern, black and white, boxed rules, booktabs tables.
% Compile with pdflatex (latexmk -pdf). Practice sets and the exam are generated by
% ../build_pdfs.py from the question data in ../sets/; guides are hand-written in guides/.
\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{apcalc}[2026/11/23 AP Calculus BC study series]
\LoadClass[11pt]{article}

\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\DeclareUnicodeCharacter{00B3}{\textsuperscript{3}}
\DeclareUnicodeCharacter{00B2}{\textsuperscript{2}}
\DeclareUnicodeCharacter{2032}{\ensuremath{'}}
\DeclareUnicodeCharacter{2033}{\ensuremath{''}}
\DeclareUnicodeCharacter{2264}{\ensuremath{\le}}
\DeclareUnicodeCharacter{2265}{\ensuremath{\ge}}
\DeclareUnicodeCharacter{2212}{\ensuremath{-}}
\DeclareUnicodeCharacter{00D7}{\ensuremath{\times}}
\RequirePackage[letterpaper,margin=1in,headheight=14pt]{geometry}
\RequirePackage{amsmath,amssymb}
\RequirePackage{microtype}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{booktabs,array,tabularx,xltabular}
\RequirePackage{enumitem}
\RequirePackage{needspace}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{multicol}
\RequirePackage[most]{tcolorbox}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{fillbetween}
\usetikzlibrary{arrows.meta,calc,patterns,decorations.markings}
\RequirePackage[hidelinks]{hyperref}

\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt plus 1pt}
\setlength{\emergencystretch}{2em}
\renewcommand{\arraystretch}{1.2}
\setlist{itemsep=1pt,topsep=3pt,parsep=0pt}
\definecolor{shade}{gray}{0.93}
\definecolor{rule}{gray}{0.55}

% ---------- metadata ----------
\newcommand\@course{AP Calculus BC}
\newcommand\@volume{}
\newcommand\volume[1]{\renewcommand\@volume{#1}}
\newcommand\@shorttitle{}
\newcommand\shorttitle[1]{\renewcommand\@shorttitle{#1}}
\newcommand\@affil{AP Calculus BC \textperiodcentered\ Paul Wang LLC}
\newcommand\affil[1]{\renewcommand\@affil{#1}}

\renewcommand\maketitle{%
  \thispagestyle{plain}%
  \begin{center}
    {\LARGE\bfseries \@title\par}
    \vspace{8pt}
    {\large \@author\par}
    \vspace{4pt}
    {\small \@affil\par}
    \vspace{3pt}
    {\small \@date\quad\textperiodcentered\quad \@volume\par}
  \end{center}
  \vspace{2pt}\noindent\rule{\linewidth}{0.8pt}\par\vspace{2pt}}

\renewenvironment{abstract}%
  {\begin{center}\small\bfseries Abstract\end{center}\vspace{-6pt}\begin{quote}\small}%
  {\end{quote}}
\newcommand\keywords[1]{\par\vspace{2pt}{\small\textbf{Keywords:} #1}\par}

% scoring line:  \scoringline{<total>}{<pace text>}
\newcommand\blank[1][3.6em]{\underline{\hspace{#1}}}
\newcommand\scoringline[2]{%
  \par\vspace{6pt}\noindent\rule{\linewidth}{0.8pt}\par\vspace{2pt}
  \noindent\textbf{Score:}\ \blank\ / #1\hfill\textbf{Time:}\ \blank\hfill\textbf{Date:}\ \blank[5em]\par
  \vspace{2pt}{\small\itshape #2\par}\vspace{2pt}\noindent\rule{\linewidth}{0.4pt}\par\vspace{4pt}}

% ---------- headings ----------
\titleformat{\section}{\large\bfseries}{\thesection}{0.8em}{}[\ap@mark]
\titleformat{name=\section,numberless}{\large\bfseries}{}{0em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.7em}{}
\titlespacing*{\section}{0pt}{16pt}{6pt}
\titlespacing*{\subsection}{0pt}{10pt}{4pt}
\let\ap@section\section
\renewcommand\section{\needspace{9\baselineskip}\ap@section}
\let\ap@subsection\subsection
\renewcommand\subsection{\needspace{6\baselineskip}\ap@subsection}

% Record each numbered section's page in \jobname.pages (read by the quiz builder).
\newwrite\ap@pagefile
\AtBeginDocument{\immediate\openout\ap@pagefile=\jobname.pages}
\newcommand\ap@mark{\protected@edef\ap@tmp{\noexpand\write\ap@pagefile{\thesection\space\noexpand\thepage}}\ap@tmp}
\AtBeginDocument{\hypersetup{pdftitle={\@title},pdfauthor={Paul Wang}}}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small P. Wang --- \@course}
\fancyhead[R]{\small\itshape \@shorttitle}
\fancyfoot[C]{\small \thepage\ / \pageref*{LastPage}}
\renewcommand{\headrulewidth}{0.4pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small \thepage\ / \pageref*{LastPage}}\renewcommand{\headrulewidth}{0pt}}

% ---------- guide boxes ----------
% \begin{rulebox}{R6.3}{Fundamental Theorem of Calculus} ... \end{rulebox}
\newtcolorbox{rulebox}[2]{enhanced,breakable,colback=white,colframe=black,boxrule=0.5pt,arc=0pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt,colbacktitle=black,coltitle=white,
  fonttitle=\small\bfseries,title={#1\quad$|$\quad #2},before skip=8pt,after skip=6pt}
\newtcolorbox{example}[1]{enhanced,breakable,colback=shade,colframe=shade,boxrule=0pt,arc=0pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt,before skip=6pt,after skip=6pt,
  before upper={{\small\textbf{Worked example} --- #1}\par\smallskip}}
\newtcolorbox{trap}{enhanced,breakable,colback=white,colframe=black,boxrule=0pt,leftrule=2pt,arc=0pt,
  left=6pt,right=4pt,top=2pt,bottom=2pt,before skip=6pt,after skip=6pt,
  before upper={\textbf{Trap.}\ }}
\newtcolorbox{frqtip}{enhanced,breakable,colback=white,colframe=rule,boxrule=0.4pt,arc=0pt,
  left=6pt,right=6pt,top=3pt,bottom=3pt,before skip=6pt,after skip=6pt,
  before upper={\textbf{On the free response.}\ }}
\newcommand\answer[1]{\textbf{Answer:} #1}

% router / reference tables: \begin{router} a & b & c \\ ... \end{router}
\newenvironment{router}%
  {\par\smallskip\noindent\small\xltabular{\linewidth}{@{}>{\raggedright\arraybackslash}p{2.35in}>{\raggedright\arraybackslash}X>{\raggedright\arraybackslash}p{0.75in}@{}}
   \toprule \textbf{If you see \dots} & \textbf{then \dots} & \textbf{Rule}\\\midrule\endhead}%
  {\bottomrule\endxltabular\par\smallskip}
\newenvironment{reftable}%
  {\par\smallskip\noindent\small\xltabular{\linewidth}{@{}>{\raggedright\arraybackslash}p{1.9in}>{\raggedright\arraybackslash}X@{}}
   \toprule \textbf{Item} & \textbf{Statement}\\\midrule\endhead}%
  {\bottomrule\endxltabular\par\smallskip}

% ---------- questions (practice sets, exam) ----------
\newcounter{qnum}
\newcommand\calcmark{\hfill{\small\itshape[calculator]}}
% \begin{q}{<number>} stem \end{q}; the answer blank sits beside the number
\newenvironment{q}[1]{%
  \par\needspace{7\baselineskip}\vspace{4pt}%
  \begin{list}{}{\leftmargin=5.6em\labelwidth=5em\labelsep=0.6em\itemsep=0pt\topsep=2pt\parsep=3pt}%
  \item[{\makebox[3em][l]{\rule[-1.5pt]{2.6em}{0.5pt}}\makebox[1.8em][r]{\textbf{#1.}}}]}%
  {\end{list}\par\vspace{2pt}}
\newcommand\chfour[4]{\par\nopagebreak\vspace{2pt}\noindent
  \makebox[0.25\linewidth][l]{(A)\ #1}\makebox[0.25\linewidth][l]{(B)\ #2}%
  \makebox[0.25\linewidth][l]{(C)\ #3}\makebox[0.25\linewidth][l]{(D)\ #4}\par}
\newcommand\chtwo[4]{\par\nopagebreak\vspace{2pt}\noindent
  \makebox[0.5\linewidth][l]{(A)\ #1}\makebox[0.5\linewidth][l]{(B)\ #2}\par\noindent
  \makebox[0.5\linewidth][l]{(C)\ #3}\makebox[0.5\linewidth][l]{(D)\ #4}\par}
\newcommand\chone[4]{\par\nopagebreak
  \begin{enumerate}[label=(\Alph*),leftmargin=2.2em,itemsep=1pt,topsep=2pt]
  \item #1 \item #2 \item #3 \item #4 \end{enumerate}}

% section-opening rule box in practice sets
\newtcolorbox{setrule}{enhanced,breakable,colback=shade,colframe=black,boxrule=0.4pt,arc=0pt,
  left=6pt,right=6pt,top=3pt,bottom=3pt,fontupper=\small,before skip=4pt,after skip=6pt}

% free response
\newtcolorbox{frq}[1]{enhanced,breakable,colback=white,colframe=black,boxrule=0.6pt,arc=0pt,
  left=8pt,right=8pt,top=5pt,bottom=5pt,colbacktitle=black,coltitle=white,fonttitle=\small\bfseries,title={#1}}
\newcommand\workspace[1]{\par\vspace{#1}\par}
\newcommand\partlabel[1]{\par\smallskip\noindent\textbf{(#1)}\ }

% answer key
\newcommand\keystrip[1]{%
  \begin{tcolorbox}[enhanced,colback=shade,colframe=black,boxrule=0.5pt,arc=0pt,left=6pt,right=6pt,top=4pt,bottom=4pt,
    colbacktitle=black,coltitle=white,fonttitle=\small\bfseries,title=Answers only]
    \raggedright\small #1
  \end{tcolorbox}}
\newcommand\keyitem[2]{\mbox{\textbf{#1}.\,#2}\hspace{1.1em}\allowbreak}
\newenvironment{keytable}%
  {\par\small\noindent\xltabular{\linewidth}{@{}>{\raggedleft\arraybackslash}p{1.7em}>{\centering\arraybackslash}p{2.6em}>{\raggedright\arraybackslash}X>{\raggedright\arraybackslash}p{0.95in}@{}}
   \toprule \textbf{\#} & \textbf{Ans.} & \textbf{Why} & \textbf{Rule}\\\midrule\endhead}%
  {\bottomrule\endxltabular\par}
\newcommand\keysection[1]{\multicolumn{4}{@{}l}{\textsc{#1}}\\}
