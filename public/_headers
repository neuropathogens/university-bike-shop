# Unlisted static pages: keep them out of search engines.
/secret/*
  X-Robots-Tag: noindex, nofollow, noarchive

# The site directory lists the unlisted pages, so it stays out of search engines too.
/directory
  X-Robots-Tag: noindex, nofollow, noarchive
/directory/*
  X-Robots-Tag: noindex, nofollow, noarchive

# Inventory bike photos rarely change: let browsers keep them for 30 days
# instead of re-checking each one. Use a new file name when replacing a photo.
/bikes/*
  Cache-Control: public, max-age=2592000
